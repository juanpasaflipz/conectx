{
  "rules": {
    ".read": false,
    ".write": false,
    "invites": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('creatorUid').val() === auth.uid)",
        ".validate": "newData.hasChildren(['squadId', 'name', 'createdAt', 'creatorUid'])"
      }
    },
    "squads": {
      "$squadId": {
        "members": {
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || root.child('squads').child($squadId).child('members').child(auth.uid).exists())",
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "records": {
          ".read": "auth != null && root.child('squads').child($squadId).child('members').child(auth.uid).exists()",
          "$recordId": {
            ".write": "auth != null && root.child('squads').child($squadId).child('members').child(auth.uid).exists() && newData.child('firebaseUid').val() === auth.uid",
            ".validate": "newData.hasChildren(['id', 'squadId', 'authorId', 'lamportClock', 'timestamp', 'type', 'firebaseUid', 'payload', 'signature'])"
          },
          ".indexOn": ["lamportClock", "timestamp"]
        },
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('squads').child($squadId).child('members').child(auth.uid).exists()"
        }
      }
    }
  }
}
